{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"name": "قرمز برند",
					"slug": "brand-red",
					"color": "#c52232"
				},
				{
					"name": "قرمز تیره برند",
					"slug": "brand-red-dark",
					"color": "#a81827"
				},
				{
					"name": "قرمز روشن",
					"slug": "brand-red-light",
					"color": "#f8e9eb"
				},
				{
					"name": "جوهر (متن اصلی)",
					"slug": "ink",
					"color": "#1a1b1f"
				},
				{
					"name": "خاکستری متوسط",
					"slug": "muted",
					"color": "#6e7077"
				},
				{
					"name": "پس‌زمینه",
					"slug": "bg",
					"color": "#f6f4f1"
				},
				{
					"name": "سطح",
					"slug": "surface",
					"color": "#fffdfa"
				},
				{
					"name": "سطح ثانوی",
					"slug": "surface-2",
					"color": "#efede9"
				},
				{
					"name": "سیاه عمیق",
					"slug": "deep",
					"color": "#151619"
				},
				{
					"name": "سفید",
					"slug": "white",
					"color": "#ffffff"
				}
			],
			"defaultPalette": false,
			"defaultGradients": false,
			"customGradient": true,
			"link": true,
			"custom": true
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "وزیرمتن (فارسی)",
					"slug": "vazirmatn",
					"fontFamily": "'Vazirmatn', 'B Yekan', 'Yekan Bakh', Tahoma, Arial, sans-serif"
				},
				{
					"name": "Monospace (لاتین فنی)",
					"slug": "mono",
					"fontFamily": "'Courier New', Courier, monospace"
				}
			],
			"fontSizes": [
				{ "name": "کوچک", "slug": "small",  "size": "12px" },
				{ "name": "معمولی", "slug": "normal", "size": "14px" },
				{ "name": "متوسط", "slug": "medium", "size": "16px" },
				{ "name": "بزرگ",  "slug": "large",  "size": "20px" },
				{ "name": "خیلی بزرگ", "slug": "x-large", "size": "clamp(24px, 3.2vw, 36px)" },
				{ "name": "عنوان اصلی", "slug": "hero", "size": "clamp(34px, 4.5vw, 54px)" }
			],
			"defaultFontSizes": false,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"writingMode": true
		},
		"spacing": {
			"spacingScale": {
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem",
				"operator": "*",
				"increment": 1.5,
				"type": "geometricProgression"
			},
			"defaultSpacingSizes": false,
			"customSpacingSize": true,
			"units": [ "px", "em", "rem", "%" ]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"layout": {
			"contentSize": "780px",
			"wideSize": "1240px"
		},
		"useRootPaddingAwareAlignments": true,
		"appearanceTools": true
	},
	"styles": {
		"color": {
			"background": "var(--hd-bg)",
			"text": "var(--hd-ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vazirmatn)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--hd-red)"
				},
				":hover": {
					"color": {
						"text": "var(--hd-red-dark)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "800",
					"lineHeight": "1.25"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "800",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "full-width",
			"title": "تمام‌عرض",
			"postTypes": [ "page", "course" ]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "هدر سایت",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "فوتر سایت",
			"area": "footer"
		}
	]
}
