# WP-CLI image for the disposable local integration-test environment.
# Adds a MySQL client (needed by `wp db reset` / `wp db query`) and bash to the
# official Alpine-based WP-CLI image. PHP 8.3 to match staging.
FROM wordpress:cli-php8.3

USER root
RUN set -eux; \
    apk add --no-cache bash mariadb-client less
USER www-data
