# Copy to `docker/.env` and adjust if needed. `docker/.env` is gitignored.
# These credentials are for a DISPOSABLE LOCAL CONTAINER ONLY — never reuse a
# real secret here, and never point this environment at a real database.

# Database
WP_DB_NAME=hedayati_wp
WP_DB_USER=hedayati
WP_DB_PASSWORD=hedayati_local_only
MYSQL_ROOT_PASSWORD=root_local_only

# WordPress
# mystik_ mirrors the staging convention that the table prefix is never "wp_".
WP_TABLE_PREFIX=mystik_
WP_HOST_PORT=8080
WP_URL=http://localhost:8080
# Quoted because it contains spaces — both the bash and PowerShell loaders
# strip one matching pair of surrounding quotes; Compose does the same.
WP_TITLE="Hedayati Local Test"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_local_only
WP_ADMIN_EMAIL=admin@hedayati.test
WP_VERSION=6.6
